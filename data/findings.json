  "policy_events": [
   {
    "date": "2000-07-01",
    "date_label": "1 July 2000",
    "background": true,
    "label": "Lifetime Health Cover introduced",
    "what": "People taking out hospital cover after age 30 pay a 2% loading on the premium for each year over 30, up to 70%, removed after 10 years of continuous cover. Background: it predates the series, which starts in June 2007.",
    "source_name": "Department of Health and Aged Care, privatehealth.gov.au, Lifetime Health Cover",
    "source": "https://www.privatehealth.gov.au/health_insurance/surcharges_incentives/lifetime_health_cover.htm",
    "explains": ""
   },
   {
    "date": "2008-07-01",
    "date_label": "1 July 2008",
    "background": false,
    "label": "Medicare Levy Surcharge thresholds raised",
    "what": "The income threshold above which people without hospital cover pay the surcharge rose from $50,000 to $70,000 for singles and from $100,000 to $140,000 for families, from the 2008-09 income year.",
    "source_name": "Parliament of Australia, Tax Laws Amendment (Medicare Levy Surcharge Thresholds) Bill (No. 2) 2008",
    "source": "https://aph.gov.au/Parliamentary_Business/Bills_Legislation/Bills_Search_Results/Result?bId=r3094",
    "explains": ""
   },
   {
    "date": "2012-07-01",
    "date_label": "1 July 2012",
    "background": false,
    "label": "Private health insurance rebate means-tested",
    "what": "The rebate fell in three income tiers from $84,001 for singles and $168,001 for families, and stopped at $130,001 and $260,001.",
    "source_name": "Parliamentary Library, FlagPost on the legislation to means test the rebate (2011); National Seniors fact sheet on the enacted thresholds",
    "source": "https://www.aph.gov.au/About_Parliament/Parliamentary_Departments/Parliamentary_Library/FlagPost/2011/July/Legislation_to_means_test_the_private_health_insurance_rebate_re-introduceddebate_continues",
    "explains": ""
   },
   {
    "date": "2014-04-01",
    "date_label": "1 April 2014",
    "background": false,
    "label": "Rebate tied to an indexed base premium",
    "what": "The rebate applies to a base premium indexed by the lesser of CPI and the insurer's premium rise, so the rebate's share of the premium falls when premiums rise faster than CPI.",
    "source_name": "Parliamentary Library, Bills Digest no. 35 2013-14 (Private Health Insurance Legislation Amendment (Base Premium) Bill)",
    "source": "https://aph.gov.au/Parliamentary_Business/Bills_Legislation/bd/bd1314a/14bd035",
    "explains": ""
   },
   {
    "date": "2019-04-01",
    "date_label": "1 April 2019",
    "background": false,
    "label": "Private health insurance reforms",
    "what": "The maximum voluntary excess rose from $500 to $750 for singles and from $1,000 to $1,500 for couples and families; hospital products were classified Gold, Silver, Bronze or Basic, mandatory from 1 April 2020; insurers could offer people aged 18 to 29 a discount of 2% of the hospital premium for each year under 30, up to 10%.",
    "source_name": "Department of Health and Aged Care, privatehealth.gov.au, Private Health Insurance Changes",
    "source": "https://www.privatehealth.gov.au/health_insurance/phichanges/index.htm",
    "explains": "The climb in hospital policies with an excess over $500 from this date: the rule allowed excesses above $500 for the first time (docs/series-breaks.md)."
   },
   {
    "date": "2020-04-01",
    "date_label": "1 April 2020",
    "background": false,
    "label": "COVID-19: the April premium increase deferred",
    "what": "Private Healthcare Australia's member funds postponed the 1 April 2020 premium increase for at least six months.",
    "source_name": "Commonwealth Ombudsman, Private Health Insurance Quarterly Bulletin 94",
    "source": "https://www.ombudsman.gov.au/__data/assets/pdf_file/0010/111115/PHI-QB-94.pdf",
    "explains": ""
   }
