annotation PBI_ProTooling = ["DevMode"]

ref table dim_age_band
ref table dim_cover
ref table dim_date
ref table dim_excess
ref table dim_gender
ref table dim_state
ref table fact_insured
ref table fact_policies
ref table fact_population
