/// Holds every measure, so none of them pretend to belong to a real table. Its one column is a hidden placeholder, because a table cannot be empty.
table _Measures
	lineageTag: cb39666b-c58c-4eef-a010-10446e152b20

	/// People with hospital cover at the end of the latest quarter in view.
	measure 'Insured Persons' =
			VAR LastQuarter = MAX ( fact_insured[quarter_end] )
			RETURN
			    CALCULATE ( SUM ( fact_insured[insured_persons] ), fact_insured[quarter_end] = LastQuarter )
		formatString: #,0
		displayFolder: Counts and coverage
		lineageTag: 4f91fcd6-e5b9-4daf-8318-79eeff7d0b22

	/// Hospital policies at the end of the latest quarter in view.
	measure 'Hospital Policies' =
			VAR LastQuarter = MAX ( fact_policies[quarter_end] )
			RETURN
			    CALCULATE ( SUM ( fact_policies[policies] ), fact_policies[quarter_end] = LastQuarter )
		formatString: #,0
		displayFolder: Counts and coverage
		lineageTag: 5070aa08-74c1-46a5-b5e2-ef3ab0b7db99

	/// State population at the end of the latest quarter in view. A hidden helper for Coverage Rate.
	measure 'Total Population' =
			VAR LastQuarter = MAX ( fact_population[quarter_end] )
			RETURN
			    CALCULATE ( SUM ( fact_population[population] ), fact_population[quarter_end] = LastQuarter )
		formatString: #,0
		isHidden
		displayFolder: Counts and coverage
		lineageTag: 300eabdc-0e12-4e74-aaa0-b23543f23d7e

	/// The honest headline: the share of people with hospital cover. Population grows, so a record headcount can hide a falling share.
	measure 'Coverage Rate' = DIVIDE ( [Insured Persons], [Total Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Counts and coverage
		lineageTag: e578ae01-64aa-4d70-b459-6f17146a839e

	/// People with hospital cover, against the same quarter a year earlier. Blank when there is no year earlier to compare with, rather than a misleading zero.
	measure 'Insured Persons, Change on a Year Earlier' =
			VAR LastQuarter = MAX ( fact_insured[quarter_end] )
			VAR YearEarlier = EDATE ( LastQuarter, -12 )
			VAR YearEarlierValue =
			    CALCULATE (
			        SUM ( fact_insured[insured_persons] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_insured[quarter_end] = YearEarlier
			    )
			RETURN
			    IF ( NOT ISBLANK ( YearEarlierValue ), [Insured Persons] - YearEarlierValue )
		formatString: +#,0;-#,0
		displayFolder: Change on a year earlier
		lineageTag: 9856d027-2c48-4cc1-842b-365d925e3ce3

	/// Share of hospital policies with full cover: no reduced cover, no lifetime exclusions.
	measure 'Full Cover Share' =
			DIVIDE (
			    CALCULATE ( [Hospital Policies], KEEPFILTERS ( dim_cover[cover_group] = "Full cover" ) ),
			    CALCULATE ( [Hospital Policies], REMOVEFILTERS ( dim_cover ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Downgrading
		lineageTag: 730caa88-9895-412c-96b1-2aabf1e8c7f0

	/// Share of hospital policies whose excess is over 500 dollars (single).
	measure 'Excess Over 500 Share' =
			DIVIDE (
			    CALCULATE ( [Hospital Policies], KEEPFILTERS ( dim_excess[excess] = "Over $500 single" ) ),
			    CALCULATE ( [Hospital Policies], REMOVEFILTERS ( dim_excess ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Downgrading
		lineageTag: ff0acdd9-b884-4ba7-85e8-918778b06372

	/// Share of insured people aged 65 or over, in the latest June with population data.
	measure 'Share Aged 65+, Insured' =
			VAR LastJune = MAX ( fact_population_by_age[quarter_end] )
			RETURN
			    DIVIDE (
			        CALCULATE ( SUM ( fact_insured[insured_persons] ), fact_insured[quarter_end] = LastJune,
			                    KEEPFILTERS ( dim_age_band[is_65_plus] = TRUE () ) ),
			        CALCULATE ( SUM ( fact_insured[insured_persons] ), fact_insured[quarter_end] = LastJune,
			                    REMOVEFILTERS ( dim_age_band ) )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: An older pool
		lineageTag: f9a79a7d-e3fd-44b8-a763-4f35ec3e44c9

	/// The same share for all Australians: the comparison that matters.
	measure 'Share Aged 65+, Australia' =
			VAR LastJune = MAX ( fact_population_by_age[quarter_end] )
			RETURN
			    DIVIDE (
			        CALCULATE ( SUM ( fact_population_by_age[population] ),
			                    fact_population_by_age[quarter_end] = LastJune,
			                    KEEPFILTERS ( dim_age_band[is_65_plus] = TRUE () ) ),
			        CALCULATE ( SUM ( fact_population_by_age[population] ),
			                    fact_population_by_age[quarter_end] = LastJune,
			                    REMOVEFILTERS ( dim_age_band ) )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: An older pool
		lineageTag: 770a39fb-9618-47fe-af2b-1e3d4f92f5ee

	/// How far the insured pool's 65+ share runs ahead of the country's, in percentage points.
	measure 'Age Gap (points)' = ( [Share Aged 65+, Insured] - [Share Aged 65+, Australia] ) * 100
		formatString: 0.0
		displayFolder: An older pool
		lineageTag: eea6f061-4edf-4f08-8c9c-9b3263316f9f

	/// Gap between the insured pool's 65+ share and Australia's at each June, in percentage points: the columns of the 65+ chart.
	measure 'Age Gap Series (points)' = ( [Share Aged 65+, Insured] - [Share Aged 65+, Australia] ) * 100
		formatString: 0.0
		displayFolder: An older pool
		lineageTag: c4b39ac6-e120-450a-a2af-eeab28d5b4d0

	/// Hospital coverage within an age band or group, each June. National only: population by age has no state, so it is blank under a state filter. Also blank where APRA's population table lacks a gender and band that the insured count includes (women 95+, June 2018), rather than a rate with a hole in its denominator.
	measure 'Coverage Rate by Age' =
			VAR LastJune = MAX ( fact_population_by_age[quarter_end] )
			VAR Insured =
			    CALCULATE ( SUM ( fact_insured[insured_persons] ), fact_insured[quarter_end] = LastJune )
			VAR People =
			    CALCULATE ( SUM ( fact_population_by_age[population] ),
			                fact_population_by_age[quarter_end] = LastJune )
			VAR InsuredPairs =
			    CALCULATE ( COUNTROWS ( SUMMARIZE ( fact_insured, fact_insured[gender], fact_insured[age_band_start] ) ),
			                fact_insured[quarter_end] = LastJune )
			VAR PeoplePairs =
			    CALCULATE ( COUNTROWS ( SUMMARIZE ( fact_population_by_age, fact_population_by_age[gender],
			                                        fact_population_by_age[age_band_start] ) ),
			                fact_population_by_age[quarter_end] = LastJune )
			RETURN
			    IF ( NOT ISFILTERED ( dim_state ) && InsuredPairs = PeoplePairs, DIVIDE ( Insured, People ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: An older pool
		lineageTag: a7e63de0-afe8-4a8f-9348-2bcad6b27b2a

	/// For every page's header: updates itself when a new release loads.
	measure 'Data Period' =
			"APRA data · " & FORMAT ( MIN ( fact_insured[quarter_end] ), "mmmm yyyy" ) & " to "
			    & FORMAT ( MAX ( fact_insured[quarter_end] ), "mmmm yyyy" )
		displayFolder: Labels
		lineageTag: d42401c9-76ac-4832-8cfb-a5e3f0cb8b15

	/// The June that page 3's cards describe.
	measure 'Population Year' = FORMAT ( MAX ( fact_population_by_age[quarter_end] ), "mmmm yyyy" )
		displayFolder: Labels
		lineageTag: 76dcbb70-d452-4aff-8bf8-6c5cb3689fdd

	/// A tick and Yes, or No, for the reconciliation table: whether ours rounds to the published figure. The SQL view stores it as true or false.
	measure 'Reconciliation Match' = IF ( HASONEVALUE ( reconciliation_panel[matches] ), IF ( SELECTEDVALUE ( reconciliation_panel[matches] ), "✓ Yes", "No" ) )
		displayFolder: Table
		lineageTag: 33499bab-8a54-4a12-a93e-93081b6d7303

	/// KPI context line: change in people with hospital cover since the first quarter of data.
	measure 'Insured Persons Context' =
			VAR FirstQuarter = CALCULATE ( MIN ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR AtFirst = CALCULATE ( [Insured Persons], REMOVEFILTERS ( dim_date ), fact_insured[quarter_end] = FirstQuarter )
			VAR Growth = DIVIDE ( [Insured Persons] - AtFirst, AtFirst )
			RETURN
			    IF (
			        NOT ISBLANK ( Growth ),
			        IF ( Growth < 0, "Down ", "Up " ) & FORMAT ( ABS ( Growth ), "0.0%" ) & " since "
			            & FORMAT ( FirstQuarter, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: 345390a3-3e0a-4e03-afa7-5a9000010ad7

	/// KPI context line: the change on a year earlier as a percentage of that year's count.
	measure 'Insured Persons Change Context' =
			VAR LastQuarter = MAX ( fact_insured[quarter_end] )
			VAR YearEarlier = EDATE ( LastQuarter, -12 )
			VAR EarlierCount =
			    CALCULATE (
			        SUM ( fact_insured[insured_persons] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_insured[quarter_end] = YearEarlier
			    )
			VAR Growth = DIVIDE ( [Insured Persons] - EarlierCount, EarlierCount )
			RETURN
			    IF (
			        NOT ISBLANK ( Growth ),
			        IF ( Growth < 0, "Down ", "Up " ) & FORMAT ( ABS ( Growth ), "0.0%" ) & " on "
			            & FORMAT ( YearEarlier, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: d3286b10-0280-4997-a126-dd72494d45f6

	/// KPI context line: the highest share of Australians covered in any quarter, and when.
	measure 'Coverage Rate Context' =
			VAR Rates =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( dim_date[quarter_end] ), REMOVEFILTERS ( dim_date ) ),
			        "@Rate", [Coverage Rate]
			    )
			VAR Peak = TOPN ( 1, FILTER ( Rates, NOT ISBLANK ( [@Rate] ) ), [@Rate], DESC )
			VAR PeakRate = MAXX ( Peak, [@Rate] )
			VAR PeakQuarter = MAXX ( Peak, dim_date[quarter_end] )
			RETURN
			    IF (
			        NOT ISBLANK ( PeakRate ),
			        "Peak " & FORMAT ( PeakRate, "0.0%" ) & " in " & FORMAT ( PeakQuarter, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: 0fe69c54-3fda-4ea4-bcba-4dca7fb322ee

	/// KPI context line: change in hospital policies since the first quarter of data.
	measure 'Hospital Policies Context' =
			VAR FirstQuarter = CALCULATE ( MIN ( fact_policies[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR AtFirst = CALCULATE ( [Hospital Policies], REMOVEFILTERS ( dim_date ), fact_policies[quarter_end] = FirstQuarter )
			VAR Growth = DIVIDE ( [Hospital Policies] - AtFirst, AtFirst )
			RETURN
			    IF (
			        NOT ISBLANK ( Growth ),
			        IF ( Growth < 0, "Down ", "Up " ) & FORMAT ( ABS ( Growth ), "0.0%" ) & " since "
			            & FORMAT ( FirstQuarter, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: 6c2c6bc4-e257-4ff5-a46f-35ddd9ee4103

	/// KPI context line: the full cover share in the first quarter of data.
	measure 'Full Cover Share Context' =
			VAR FirstQuarter = CALCULATE ( MIN ( fact_policies[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR AtFirst = CALCULATE ( [Full Cover Share], REMOVEFILTERS ( dim_date ), fact_policies[quarter_end] = FirstQuarter )
			VAR Latest = [Full Cover Share]
			RETURN
			    IF (
			        NOT ISBLANK ( AtFirst ) && NOT ISBLANK ( Latest ),
			        IF ( Latest < AtFirst, "Down from ", "Up from " ) & FORMAT ( AtFirst, "0.0%" ) & " in "
			            & FORMAT ( FirstQuarter, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: 23e04f77-d805-46dc-986d-e0a20e041abd

	/// KPI context line: the share with an excess over 500 dollars in March 2019, the last quarter before the 1 April 2019 rule change.
	measure 'Excess Over 500 Share Context' =
			VAR RuleQuarter = DATE ( 2019, 3, 31 )
			VAR AtRule = CALCULATE ( [Excess Over 500 Share], REMOVEFILTERS ( dim_date ), fact_policies[quarter_end] = RuleQuarter )
			VAR Latest = [Excess Over 500 Share]
			RETURN
			    IF (
			        NOT ISBLANK ( AtRule ) && NOT ISBLANK ( Latest ),
			        IF ( Latest < AtRule, "Down from ", "Up from " ) & FORMAT ( AtRule, "0.0%" ) & " in "
			            & FORMAT ( RuleQuarter, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: 90fd876d-2c76-4f0f-8bfc-452bc7879a0c

	/// KPI context line: the insured 65+ share in the first June with population by age.
	measure 'Share Aged 65+, Insured Context' =
			VAR FirstJune = CALCULATE ( MIN ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR AtFirst =
			    CALCULATE ( [Share Aged 65+, Insured], REMOVEFILTERS ( dim_date ), fact_population_by_age[quarter_end] = FirstJune )
			VAR Latest = [Share Aged 65+, Insured]
			RETURN
			    IF (
			        NOT ISBLANK ( AtFirst ) && NOT ISBLANK ( Latest ),
			        IF ( Latest < AtFirst, "Down from ", "Up from " ) & FORMAT ( AtFirst, "0.0%" ) & " in "
			            & FORMAT ( FirstJune, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: ac942234-5324-462e-acec-2389714f54f2

	/// KPI context line: the 65+ share of all Australians in the first June with population by age.
	measure 'Share Aged 65+, Australia Context' =
			VAR FirstJune = CALCULATE ( MIN ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR AtFirst =
			    CALCULATE ( [Share Aged 65+, Australia], REMOVEFILTERS ( dim_date ), fact_population_by_age[quarter_end] = FirstJune )
			VAR Latest = [Share Aged 65+, Australia]
			RETURN
			    IF (
			        NOT ISBLANK ( AtFirst ) && NOT ISBLANK ( Latest ),
			        IF ( Latest < AtFirst, "Down from ", "Up from " ) & FORMAT ( AtFirst, "0.0%" ) & " in "
			            & FORMAT ( FirstJune, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: a5e0596e-9442-498a-ba43-9fe69da7b7b1

	/// KPI context line: the gap between the insured and Australian 65+ shares in the first June, in points.
	measure 'Age Gap Context' =
			VAR FirstJune = CALCULATE ( MIN ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR AtFirst =
			    CALCULATE ( [Age Gap (points)], REMOVEFILTERS ( dim_date ), fact_population_by_age[quarter_end] = FirstJune )
			VAR Latest = [Age Gap (points)]
			RETURN
			    IF (
			        NOT ISBLANK ( AtFirst ) && NOT ISBLANK ( Latest ),
			        IF ( Latest < AtFirst, "Down from ", "Up from " ) & FORMAT ( AtFirst, "0.0" ) & " points in "
			            & FORMAT ( FirstJune, "mmmm yyyy" )
			    )
		displayFolder: Context lines
		lineageTag: e7863432-81f5-46a9-8732-b50c7608635b

	/// KPI label for page 3, ending in the June it describes.
	measure 'Share Aged 65+, Insured Label' = "Insured people aged 65+ · " & [Population Year]
		displayFolder: KPI labels
		lineageTag: 9f567d5c-3ccb-43db-8efe-6760e1753133

	/// KPI label for page 3, ending in the June it describes.
	measure 'Share Aged 65+, Australia Label' = "All Australians aged 65+ · " & [Population Year]
		displayFolder: KPI labels
		lineageTag: 16768cff-7ec1-41db-afcd-04bb189aca5c

	/// KPI label for page 3, ending in the June it describes.
	measure 'Age Gap Label' = "Gap, percentage points · " & [Population Year]
		displayFolder: KPI labels
		lineageTag: fc764cd3-5234-4e56-80db-05d73eb7b2a3

	/// Data label for the full cover line: the first and latest quarters only.
	measure 'Full Cover Share Key Label' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR FirstQuarter = CALCULATE ( MIN ( fact_policies[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR LatestQuarter = CALCULATE ( MAX ( fact_policies[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF ( ThisQuarter = FirstQuarter || ThisQuarter = LatestQuarter, FORMAT ( [Full Cover Share], "0.0%" ) )
		displayFolder: Key points
		lineageTag: 4c0ca675-b049-4195-85c4-e77a658b1235

	/// Data label for the excess line: March 2019, the last quarter before the rule change, and the latest quarter.
	measure 'Excess Over 500 Share Key Label' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR LatestQuarter = CALCULATE ( MAX ( fact_policies[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF (
			        ThisQuarter = DATE ( 2019, 3, 31 ) || ThisQuarter = LatestQuarter,
			        FORMAT ( [Excess Over 500 Share], "0.0%" )
			    )
		displayFolder: Key points
		lineageTag: 54f48bd9-3fb8-4f2b-a019-4f965b36c2b4

	/// Data label for the insured 65+ line: the first and latest Junes with population by age.
	measure 'Share Aged 65+, Insured Key Label' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR FirstJune = CALCULATE ( MIN ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR LatestJune = CALCULATE ( MAX ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF ( ThisQuarter = FirstJune || ThisQuarter = LatestJune, FORMAT ( [Share Aged 65+, Insured], "0.0%" ) )
		displayFolder: Key points
		lineageTag: e7b858c4-de65-4c08-b118-f72618ad09c1

	/// Data label for the all-Australians 65+ line: the first and latest Junes with population by age.
	measure 'Share Aged 65+, Australia Key Label' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR FirstJune = CALCULATE ( MIN ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR LatestJune = CALCULATE ( MAX ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF ( ThisQuarter = FirstJune || ThisQuarter = LatestJune, FORMAT ( [Share Aged 65+, Australia], "0.0%" ) )
		displayFolder: Key points
		lineageTag: 12a35086-1016-4e4e-a1ac-f2db0245f96f

	/// Data label for the Australia 65+ line on the combo: the first June with population by age only, placed under the line.
	measure 'Share Aged 65+, Australia, First Label' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR FirstJune = CALCULATE ( MIN ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF ( ThisQuarter = FirstJune, FORMAT ( [Share Aged 65+, Australia], "0.0%" ) )
		displayFolder: Key points
		lineageTag: 56f68cee-765e-4137-b62b-ad9fb885f70e

	/// The Australia 65+ share at the latest June only, drawn invisibly, so that June's label can sit above the line.
	measure 'Share Aged 65+, Australia, Latest Point' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR LatestJune = CALCULATE ( MAX ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF ( ThisQuarter = LatestJune, [Share Aged 65+, Australia] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Key points
		lineageTag: d20c1e5a-cbc6-4b4d-ab6c-611b4a7ece36

	/// Data label for the gap columns: the latest June with population by age only (at June 2007 the 0.2 label has no room beside 13.1%).
	measure 'Age Gap Series Key Label' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR LatestJune = CALCULATE ( MAX ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF ( ThisQuarter = LatestJune, FORMAT ( [Age Gap Series (points)], "0.0" ) )
		displayFolder: Key points
		lineageTag: fe135121-76e5-47f8-b7d1-eb6791c5b4e7

	/// The national full cover share, whatever state is in view: the dashed line on the state chart.
	measure 'Full Cover Share, Australia' = CALCULATE ( [Full Cover Share], REMOVEFILTERS ( dim_state ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Reference lines
		lineageTag: ec4d496b-ef55-4c36-b864-8a30bc8a8d95

	/// Label for the national line on the state chart.
	measure 'Full Cover Share, Australia Label' = "Australia " & FORMAT ( [Full Cover Share, Australia], "0.0%" )
		displayFolder: Reference lines
		lineageTag: 82288080-c8d9-4268-bcd8-af42fb31be54

	/// Hospital coverage in each age band in the first June with population by age (tooltip).
	measure 'Coverage by Age, First June' =
			VAR FirstJune = CALCULATE ( MIN ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    CALCULATE ( [Coverage Rate by Age], REMOVEFILTERS ( dim_date ), dim_date[quarter_end] = FirstJune )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Change by age
		lineageTag: e428ecb6-1a79-4e79-b8d2-21c5d9d00ef9

	/// Hospital coverage in each age band in the latest June with population by age (tooltip).
	measure 'Coverage by Age, Latest June' =
			VAR LatestJune = CALCULATE ( MAX ( fact_population_by_age[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    CALCULATE ( [Coverage Rate by Age], REMOVEFILTERS ( dim_date ), dim_date[quarter_end] = LatestJune )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Change by age
		lineageTag: 05b01a87-4618-46b1-8a12-a5e45189e1c4

	/// Change in hospital coverage within each age band from the first to the latest June, in percentage points.
	measure 'Coverage Change by Age (points)' =
			VAR AtFirst = [Coverage by Age, First June]
			VAR AtLatest = [Coverage by Age, Latest June]
			RETURN
			    IF ( NOT ISBLANK ( AtFirst ) && NOT ISBLANK ( AtLatest ), ( AtLatest - AtFirst ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: Change by age
		lineageTag: 8763a72c-c8a1-4032-a09f-345d920d3475

	/// Who published each figure in the reconciliation table: the source text before its first comma.
	measure 'Reconciliation Source' =
			VAR SourceText = SELECTEDVALUE ( reconciliation_panel[source] )
			RETURN
			    IF ( NOT ISBLANK ( SourceText ), LEFT ( SourceText, FIND ( ",", SourceText & "," ) - 1 ) )
		displayFolder: Table
		lineageTag: 7356a33d-a4e9-4d2c-9ded-0c102c6bfdd4

	/// Top of the excess chart's value axis: the highest share times 1.5, rounded up to 5%, so the line stays clear of the rule-change note.
	measure 'Excess Over 500 Share, Axis Max' =
			VAR Highest = MAXX ( ALL ( dim_date[quarter_end] ), [Excess Over 500 Share] )
			RETURN CEILING ( Highest * 1.5, 0.05 )
		formatString: 0%
		displayFolder: Key points
		lineageTag: 263b0443-cbe6-4386-a130-c7a5478523b1

	/// How far a state's full cover share sits above or below Australia's, in percentage points.
	measure 'Full Cover Share, Gap to Australia (points)' = ( [Full Cover Share] - CALCULATE ( [Full Cover Share], REMOVEFILTERS ( dim_state ) ) ) * 100
		formatString: +0.0" pts";"−"0.0" pts";0.0" pts"
		displayFolder: State gap
		lineageTag: 569eb646-df5b-455b-b7c7-8e4d8591bce7

	/// Bar colour for the state chart: orange below Australia, blue above.
	measure 'Full Cover Share, Gap Colour' = IF ( [Full Cover Share, Gap to Australia (points)] < 0, "#EB6834", "#4C9BEF" )
		displayFolder: State gap
		lineageTag: c4d1cf9d-bad0-4a6f-b19a-ba3e5d0287e8

	/// Column colour for the change-by-age chart: orange for a fall, blue for a rise.
	measure 'Coverage Change by Age, Colour' = IF ( [Coverage Change by Age (points)] < 0, "#EB6834", "#4C9BEF" )
		displayFolder: Change by age
		lineageTag: c982725f-ba83-4dae-bc57-33955f7910e5

	/// Top of the change-by-age value axis: the largest rise plus a quarter, rounded up to 5 points, so its label fits above it.
	measure 'Coverage Change by Age, Axis Max' =
			VAR Highest = MAXX ( ALL ( dim_age_band[age_band] ), [Coverage Change by Age (points)] )
			RETURN CEILING ( MAX ( Highest, 0 ) * 1.25, 5 )
		formatString: 0
		displayFolder: Change by age
		lineageTag: d1d329e2-e092-4fc3-8cf6-e3fcbbe1c94d

	/// Share of each age group within one bar of the age-mix chart: insured people or all Australians, at that bar's June.
	measure 'Age Mix Share' =
			VAR BarBase = SELECTEDVALUE ( mix_bars[base] )
			VAR AtJune = SELECTEDVALUE ( mix_bars[june] )
			VAR InGroup =
			    SWITCH (
			        BarBase,
			        "Insured",
			            CALCULATE ( SUM ( fact_insured[insured_persons] ), REMOVEFILTERS ( dim_date ), fact_insured[quarter_end] = AtJune ),
			        "Australians",
			            CALCULATE ( SUM ( fact_population_by_age[population] ), REMOVEFILTERS ( dim_date ), fact_population_by_age[quarter_end] = AtJune )
			    )
			VAR AllAges =
			    SWITCH (
			        BarBase,
			        "Insured",
			            CALCULATE ( SUM ( fact_insured[insured_persons] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_age_band ), fact_insured[quarter_end] = AtJune ),
			        "Australians",
			            CALCULATE ( SUM ( fact_population_by_age[population] ), REMOVEFILTERS ( dim_date ), REMOVEFILTERS ( dim_age_band ), fact_population_by_age[quarter_end] = AtJune )
			    )
			RETURN
			    DIVIDE ( InGroup, AllAges )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Age mix
		lineageTag: e6e0f775-5184-4757-9bd1-ad9ff64fd36e

	/// Column label for the combo chart: the first and latest Junes only, in millions.
	measure 'Insured Persons, June Key Label' =
			VAR ThisQuarter = MAX ( dim_date[quarter_end] )
			VAR FirstJune = CALCULATE ( MIN ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ), MONTH ( fact_insured[quarter_end] ) = 6 )
			VAR LatestJune = CALCULATE ( MAX ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ), MONTH ( fact_insured[quarter_end] ) = 6 )
			RETURN
			    IF (
			        HASONEVALUE ( dim_date[year] ) && ( ThisQuarter = FirstJune || ThisQuarter = LatestJune ),
			        FORMAT ( [Insured Persons] / 1000000, "0.0" ) & "M"
			    )
		displayFolder: Key points
		lineageTag: 455bebbe-3568-415b-8a1f-01db74cb953e

	/// Line label for the combo chart, placed above the line: the peak June.
	measure 'Coverage Rate, June Label Above' =
			VAR ThisQuarter = MAX ( dim_date[quarter_end] )
			VAR Junes =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( dim_date[quarter_end] ), REMOVEFILTERS ( dim_date ), MONTH ( dim_date[quarter_end] ) = 6 ),
			        "@Rate",
			            VAR RowQuarter = dim_date[quarter_end]
			            RETURN CALCULATE ( [Coverage Rate], REMOVEFILTERS ( dim_date ), dim_date[quarter_end] = RowQuarter )
			    )
			VAR Known = FILTER ( Junes, NOT ISBLANK ( [@Rate] ) )
			VAR PeakJune = MAXX ( TOPN ( 1, Known, [@Rate], DESC ), dim_date[quarter_end] )
			RETURN
			    IF (
			        HASONEVALUE ( dim_date[year] ) && ThisQuarter = PeakJune,
			        "Peak " & FORMAT ( [Coverage Rate], "0.0%" ) & ", " & FORMAT ( PeakJune, "mmmm yyyy" )
			    )
		displayFolder: Key points
		lineageTag: b0691f1a-db31-4927-b94f-18d0ceae5312

	/// Line label for the combo chart, placed under the line: the lowest June since the peak, and the latest June unless it is the peak.
	measure 'Coverage Rate, June Label Below' =
			VAR ThisQuarter = MAX ( dim_date[quarter_end] )
			VAR Junes =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( dim_date[quarter_end] ), REMOVEFILTERS ( dim_date ), MONTH ( dim_date[quarter_end] ) = 6 ),
			        "@Rate",
			            VAR RowQuarter = dim_date[quarter_end]
			            RETURN CALCULATE ( [Coverage Rate], REMOVEFILTERS ( dim_date ), dim_date[quarter_end] = RowQuarter )
			    )
			VAR Known = FILTER ( Junes, NOT ISBLANK ( [@Rate] ) )
			VAR PeakJune = MAXX ( TOPN ( 1, Known, [@Rate], DESC ), dim_date[quarter_end] )
			VAR LowJune = MAXX ( TOPN ( 1, FILTER ( Known, dim_date[quarter_end] > PeakJune ), [@Rate], ASC ), dim_date[quarter_end] )
			VAR LatestJune = MAXX ( Known, dim_date[quarter_end] )
			VAR ThisRate = [Coverage Rate]
			RETURN
			    IF (
			        HASONEVALUE ( dim_date[year] ),
			        SWITCH (
			            TRUE (),
			            ThisQuarter = LowJune, "Low " & FORMAT ( ThisRate, "0.0%" ) & ", " & FORMAT ( LowJune, "mmmm yyyy" ),
			            ThisQuarter = LatestJune && LatestJune <> PeakJune, FORMAT ( ThisRate, "0.0%" )
			        )
			    )
		displayFolder: Key points
		lineageTag: 7a07cd35-51ad-4f6b-8d1c-9abf43ab35e0

	/// The coverage line again, drawn invisibly, so some labels can sit under the line while the peak label sits above it.
	measure 'Coverage Rate, Line for Labels Below' = [Coverage Rate]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Key points
		lineageTag: 28ffa47e-3812-47a5-8dd2-ec1c76b3b8b5

	/// People with hospital cover in the first quarter in the data (donut slice).
	measure 'Covered, First Quarter' =
			VAR AtQuarter = CALCULATE ( MIN ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    CALCULATE ( [Insured Persons], REMOVEFILTERS ( dim_date ), fact_insured[quarter_end] = AtQuarter )
		formatString: #,0
		displayFolder: Donuts
		lineageTag: 2a2a6fd4-2026-40b4-acb9-ddf6b37649e5

	/// Australians without hospital cover in the first quarter in the data (donut slice).
	measure 'Not Covered, First Quarter' =
			VAR AtQuarter = CALCULATE ( MIN ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR People = CALCULATE ( [Total Population], REMOVEFILTERS ( dim_date ), fact_population[quarter_end] = AtQuarter )
			RETURN
			    People - [Covered, First Quarter]
		formatString: #,0
		displayFolder: Donuts
		lineageTag: 9ff19fb3-70bd-47a3-bfb6-90f6938b3242

	/// Share covered in the first quarter, for the donut hole.
	measure 'Coverage Share Label, First Quarter' =
			VAR AtQuarter = CALCULATE ( MIN ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR People = CALCULATE ( [Total Population], REMOVEFILTERS ( dim_date ), fact_population[quarter_end] = AtQuarter )
			RETURN
			    FORMAT ( DIVIDE ( [Covered, First Quarter], People ), "0.0%" )
		displayFolder: Donuts
		lineageTag: abb032e9-8d20-4e39-ba41-d5cdbe6b4ece

	/// People covered of all Australians in the first quarter, for the donut hole.
	measure 'Coverage People Label, First Quarter' =
			VAR AtQuarter = CALCULATE ( MIN ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR People = CALCULATE ( [Total Population], REMOVEFILTERS ( dim_date ), fact_population[quarter_end] = AtQuarter )
			RETURN
			    FORMAT ( [Covered, First Quarter] / 1000000, "0.0" ) & "M of " & FORMAT ( People / 1000000, "0.0" ) & "M"
		displayFolder: Donuts
		lineageTag: dbdbfbc7-960a-49e4-a2c4-3175a2574176

	/// The first quarter in the data, as a donut caption.
	measure 'Quarter Label, First' = FORMAT ( CALCULATE ( MIN ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) ), "mmmm yyyy" )
		displayFolder: Donuts
		lineageTag: f9379a31-65c1-40cb-9610-e42e94807d04

	/// People with hospital cover in the latest quarter in the data (donut slice).
	measure 'Covered, Latest Quarter' =
			VAR AtQuarter = CALCULATE ( MAX ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    CALCULATE ( [Insured Persons], REMOVEFILTERS ( dim_date ), fact_insured[quarter_end] = AtQuarter )
		formatString: #,0
		displayFolder: Donuts
		lineageTag: 43e44a61-f245-43bf-985c-55f4c4c21d6a

	/// Australians without hospital cover in the latest quarter in the data (donut slice).
	measure 'Not Covered, Latest Quarter' =
			VAR AtQuarter = CALCULATE ( MAX ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR People = CALCULATE ( [Total Population], REMOVEFILTERS ( dim_date ), fact_population[quarter_end] = AtQuarter )
			RETURN
			    People - [Covered, Latest Quarter]
		formatString: #,0
		displayFolder: Donuts
		lineageTag: a5145504-35ca-4a43-b8bd-0fa17be3a7e5

	/// Share covered in the latest quarter, for the donut hole.
	measure 'Coverage Share Label, Latest Quarter' =
			VAR AtQuarter = CALCULATE ( MAX ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR People = CALCULATE ( [Total Population], REMOVEFILTERS ( dim_date ), fact_population[quarter_end] = AtQuarter )
			RETURN
			    FORMAT ( DIVIDE ( [Covered, Latest Quarter], People ), "0.0%" )
		displayFolder: Donuts
		lineageTag: 90398c1e-5ff6-4f59-bc2b-ddbe95f2440e

	/// People covered of all Australians in the latest quarter, for the donut hole.
	measure 'Coverage People Label, Latest Quarter' =
			VAR AtQuarter = CALCULATE ( MAX ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			VAR People = CALCULATE ( [Total Population], REMOVEFILTERS ( dim_date ), fact_population[quarter_end] = AtQuarter )
			RETURN
			    FORMAT ( [Covered, Latest Quarter] / 1000000, "0.0" ) & "M of " & FORMAT ( People / 1000000, "0.0" ) & "M"
		displayFolder: Donuts
		lineageTag: d53d9fdc-03a0-4b87-a3df-d6e9cc4c229d

	/// The latest quarter in the data, as a donut caption.
	measure 'Quarter Label, Latest' = FORMAT ( CALCULATE ( MAX ( fact_insured[quarter_end] ), REMOVEFILTERS ( dim_date ) ), "mmmm yyyy" )
		displayFolder: Donuts
		lineageTag: 8da45c89-6790-49e4-a762-8e380437578b

	/// The excess share up to March 2019, the last quarter before the 1 April 2019 rule change: the grey part of the excess chart.
	measure 'Excess Over 500 Share, Before Rule Change' =
			VAR ThisQuarter = MAX ( dim_date[quarter_end] )
			RETURN
			    IF ( ThisQuarter <= DATE ( 2019, 3, 31 ), [Excess Over 500 Share] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Downgrading
		lineageTag: fc3e09ec-19e2-48fb-9400-a7b62a607ee1

	/// The excess share from March 2019 on, so it meets the grey part at that point: the orange part of the excess chart.
	measure 'Excess Over 500 Share, After Rule Change' =
			VAR ThisQuarter = MAX ( dim_date[quarter_end] )
			RETURN
			    IF ( ThisQuarter >= DATE ( 2019, 3, 31 ), [Excess Over 500 Share] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Downgrading
		lineageTag: a95825fc-eed4-48c3-9c02-2ecbbcc21312

	/// Data label for the orange part of the excess chart: the latest quarter only.
	measure 'Excess Over 500 Share, Latest Label' =
			VAR ThisQuarter = SELECTEDVALUE ( dim_date[quarter_end] )
			VAR LatestQuarter = CALCULATE ( MAX ( fact_policies[quarter_end] ), REMOVEFILTERS ( dim_date ) )
			RETURN
			    IF ( ThisQuarter = LatestQuarter, FORMAT ( [Excess Over 500 Share], "0.0%" ) )
		displayFolder: Key points
		lineageTag: 64f63e8a-6800-4030-a607-3b5aff1a850b

	column Placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0fd16950-2316-4192-b068-8a4b86a265fb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW ( "Placeholder", 0 )

