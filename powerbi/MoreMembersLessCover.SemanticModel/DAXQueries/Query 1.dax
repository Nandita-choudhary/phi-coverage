
DEFINE
    VAR Checks =
        {
            ( 1, "Insured Persons", FORMAT ( [Insured Persons], "#,0" ), "12,823,752" ),
            ( 2, "Hospital Policies", FORMAT ( [Hospital Policies], "#,0" ), "6,268,336" ),
            ( 3, "Coverage Rate", FORMAT ( [Coverage Rate], "0.0%" ), "45.8%" ),
            ( 4, "Insured Persons, Change on a Year Earlier",
                 FORMAT ( [Insured Persons, Change on a Year Earlier], "+#,0;-#,0" ), "+292,743" ),
            ( 5, "Full Cover Share", FORMAT ( [Full Cover Share], "0.0%" ), "26.8%" ),
            ( 6, "Excess Over 500 Share", FORMAT ( [Excess Over 500 Share], "0.0%" ), "29.4%" ),
            ( 7, "Share Aged 65+, Insured", FORMAT ( [Share Aged 65+, Insured], "0.0%" ), "20.7%" ),
            ( 8, "Share Aged 65+, Australia", FORMAT ( [Share Aged 65+, Australia], "0.0%" ), "17.4%" ),
            ( 9, "Age Gap (points)", FORMAT ( [Age Gap (points)], "0.0" ), "3.3" ),
            ( 10, "Data Period", [Data Period], "APRA data · June 2007 to June 2026" ),
            ( 11, "Insured Persons Context", [Insured Persons Context], "Up 40.2% since June 2007" ),
            ( 12, "Insured Persons Change Context", [Insured Persons Change Context], "Up 2.3% on June 2025" ),
            ( 13, "Coverage Rate Context", [Coverage Rate Context], "Peak 47.4% in June 2015" ),
            ( 14, "Hospital Policies Context", [Hospital Policies Context], "Up 43.5% since June 2007" ),
            ( 15, "Full Cover Share Context", [Full Cover Share Context], "Down from 63.6% in June 2007" ),
            ( 16, "Excess Over 500 Share Context", [Excess Over 500 Share Context], "Up from 0.5% in March 2019" ),
            ( 17, "Share Aged 65+, Insured Context", [Share Aged 65+, Insured Context], "Up from 13.3% in June 2007" ),
            ( 18, "Share Aged 65+, Australia Context", [Share Aged 65+, Australia Context], "Up from 13.1% in June 2007" ),
            ( 19, "Age Gap Context", [Age Gap Context], "Up from 0.2 points in June 2007" ),
            ( 20, "Share Aged 65+, Insured Label", [Share Aged 65+, Insured Label], "Insured people aged 65+ · June 2025" ),
            ( 21, "Share Aged 65+, Australia Label", [Share Aged 65+, Australia Label], "All Australians aged 65+ · June 2025" ),
            ( 22, "Age Gap Label", [Age Gap Label], "Gap, percentage points · June 2025" ),
            ( 23, "Full Cover Share, Australia", FORMAT ( [Full Cover Share, Australia], "0.0%" ), "26.8%" ),
            ( 24, "Full Cover Share, Australia Label", [Full Cover Share, Australia Label], "Australia 26.8%" ),
            ( 25, "Full Cover Share Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Full Cover Share Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "June 2007 63.6%; June 2026 26.8%" ),
            ( 26, "Excess Over 500 Share Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Excess Over 500 Share Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "March 2019 0.5%; June 2026 29.4%" ),
            ( 27, "Share Aged 65+, Insured Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Share Aged 65+, Insured Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "June 2007 13.3%; June 2025 20.7%" ),
            ( 28, "Share Aged 65+, Australia Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Share Aged 65+, Australia Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "June 2007 13.1%; June 2025 17.4%" ),
            ( 29, "Coverage Change by Age (points)", CONCATENATEX ( ADDCOLUMNS ( VALUES ( dim_age_band[age_band] ), "@C", FORMAT ( [Coverage Change by Age (points)], "+0.0;-0.0;0.0" ) ), dim_age_band[age_band] & " " & [@C], "; ", CALCULATE ( MIN ( dim_age_band[age_band_start] ) ), ASC ), "0-4 -1.7; 5-9 +4.4; 10-14 +4.9; 15-19 +1.5; 20-24 +0.2; 25-29 -2.7; 30-34 -3.6; 35-39 +1.1; 40-44 +3.7; 45-49 +2.4; 50-54 -3.9; 55-59 -5.3; 60-64 -4.9; 65-69 +2.3; 70-74 +9.0; 75-79 +9.2; 80-84 +17.9; 85-89 +18.9; 90-94 +14.2; 95+ +6.4" ),
            ( 30, "Reconciliation Source", CONCATENATEX ( VALUES ( reconciliation_panel[measure] ), [Reconciliation Source], "; ", [Reconciliation Source], ASC ), "ACCC; ACCC; APRA; CHOICE; CHOICE" ),
            ( 31, "Reconciliation Match", FORMAT ( COUNTROWS ( FILTER ( VALUES ( reconciliation_panel[measure] ), [Reconciliation Match] = "✓ Yes" ) ), "0" ) & " of 5", "5 of 5" ),
            ( 32, "Coverage Share Label, First Quarter", [Coverage Share Label, First Quarter], "43.9%" ),
            ( 33, "Coverage People Label, First Quarter", [Coverage People Label, First Quarter], "9.1M of 20.8M" ),
            ( 34, "Coverage Share Label, Latest Quarter", [Coverage Share Label, Latest Quarter], "45.8%" ),
            ( 35, "Coverage People Label, Latest Quarter", [Coverage People Label, Latest Quarter], "12.8M of 28.0M" ),
            ( 36, "Quarter Label, First", [Quarter Label, First], "June 2007" ),
            ( 37, "Quarter Label, Latest", [Quarter Label, Latest], "June 2026" ),
            ( 38, "Gap to Australia (points), WA", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "WA" ), "-3.7" ),
            ( 39, "Gap to Australia (points), VIC", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "VIC" ), "-3.1" ),
            ( 40, "Gap to Australia (points), ACT", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "ACT" ), "-2.8" ),
            ( 41, "Gap to Australia (points), QLD", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "QLD" ), "+0.2" ),
            ( 42, "Gap to Australia (points), NSW", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "NSW" ), "+1.3" ),
            ( 43, "Gap to Australia (points), NT", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "NT" ), "+5.2" ),
            ( 44, "Gap to Australia (points), SA", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "SA" ), "+8.0" ),
            ( 45, "Gap to Australia (points), TAS", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "TAS" ), "+11.9" ),
            ( 46, "Age Mix Share, Insured, June 2007, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "29.7" ),
            ( 47, "Age Mix Share, Insured, June 2007, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "34.5" ),
            ( 48, "Age Mix Share, Insured, June 2007, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "22.5" ),
            ( 49, "Age Mix Share, Insured, June 2007, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "13.3" ),
            ( 50, "Age Mix Share, Insured, June 2025, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "27.4" ),
            ( 51, "Age Mix Share, Insured, June 2025, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "32.3" ),
            ( 52, "Age Mix Share, Insured, June 2025, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "19.6" ),
            ( 53, "Age Mix Share, Insured, June 2025, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "20.7" ),
            ( 54, "Age Mix Share, Australians, June 2007, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "33.4" ),
            ( 55, "Age Mix Share, Australians, June 2007, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "35.8" ),
            ( 56, "Age Mix Share, Australians, June 2007, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "17.7" ),
            ( 57, "Age Mix Share, Australians, June 2007, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "13.1" ),
            ( 58, "Age Mix Share, Australians, June 2025, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "30.2" ),
            ( 59, "Age Mix Share, Australians, June 2025, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "35.0" ),
            ( 60, "Age Mix Share, Australians, June 2025, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "17.3" ),
            ( 61, "Age Mix Share, Australians, June 2025, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "17.4" ),
            ( 62, "Age Gap (points), June 2007", CALCULATE ( FORMAT ( [Age Gap (points)], "0.0" ), dim_date[quarter_end] = DATE ( 2007, 6, 30 ) ), "0.2" ),
            ( 63, "Age Gap (points), June 2025", CALCULATE ( FORMAT ( [Age Gap (points)], "0.0" ), dim_date[quarter_end] = DATE ( 2025, 6, 30 ) ), "3.3" ),
            ( 64, "Coverage Rate, Peak", FORMAT ( [Coverage Rate, Peak], "0.0%" ), "47.4%" ),
            ( 65, "Coverage Rate, Peak Quarter", FORMAT ( [Coverage Rate, Peak Quarter], "mmmm yyyy" ), "June 2015" ),
            ( 66, "Insured Persons, Record", FORMAT ( [Insured Persons, Record], "0" ), "12823752" ),
            ( 67, "Excess Over 500 Share, September 2010 Drop", FORMAT ( [Excess Over 500 Share, September 2010 Drop], "0.0" ), "4.1" ),
            ( 68, "Takeaway, Headline", [Takeaway, Headline], "Not quite. A record 12.8 million people hold hospital cover, but since June 2015 Australia's population has grown faster than membership. The share covered, 45.8%, is still below its June 2015 peak of 47.4%." ),
            ( 69, "Title, Members and Coverage", [Title, Members and Coverage], "A record 12.8 million people have hospital cover, but the share of Australians covered is still below its 2015 peak" ),
            ( 70, "Coverage Rate, Axis Min", FORMAT ( [Coverage Rate, Axis Min], "0%" ), "39%" ),
            ( 71, "Coverage Rate, Axis Max", FORMAT ( [Coverage Rate, Axis Max], "0%" ), "52%" ),
            ( 72, "Insured Persons, Axis Max", FORMAT ( [Insured Persons, Axis Max], "0" ), "20000000" ),
            ( 73, "Subtitle, Members and Coverage", [Subtitle, Members and Coverage], "People with hospital cover at each June (columns, left axis) and the share of the population they make up (line, right axis, 39% to 52%)." ),
            ( 74, "Title, Donuts", [Title, Donuts], "The slice of Australians covered moved from 43.9% to 45.8%, while the people in it grew from 9.1M to 12.8M" ),
            ( 75, "Title, Reconciliation", [Title, Reconciliation], "5 of 5 published figures reproduced from APRA's raw data" ),
            ( 76, "Text, Reconciliation Note", [Text, Reconciliation Note], "Every figure traces back to a cell in APRA's spreadsheets. The five published figures on the right were rebuilt from them and match at the precision they were published." ),
            ( 77, "Insured Persons Label", [Insured Persons Label], "People with hospital cover · June 2026" ),
            ( 78, "Insured Persons Change Label", [Insured Persons Change Label], "Change on a year earlier · June 2026" ),
            ( 79, "Coverage Rate Label", [Coverage Rate Label], "Share of Australians covered · June 2026" ),
            ( 80, "Hospital Policies Label", [Hospital Policies Label], "Hospital policies · June 2026" ),
            ( 81, "Full Cover Share Label", [Full Cover Share Label], "With full cover · June 2026" ),
            ( 82, "Excess Over 500 Share Label", [Excess Over 500 Share Label], "With an excess over 500 dollars · June 2026" ),
            ( 83, "Takeaway, Downgrading", [Takeaway, Downgrading], "In aggregate, yes. Policies grew 43.5% since June 2007, but only 26.8% now give full cover, down from 63.6%. And 29.4% carry an excess over 500 dollars, up from 0.5% before the April 2019 rule change." ),
            ( 84, "Title, Full Cover", [Title, Full Cover], "Policies grew 43.5% since June 2007, but only 26.8% now give full cover, down from 63.6%" ),
            ( 85, "Full Cover Share, Axis Max", FORMAT ( [Full Cover Share, Axis Max], "0%" ), "80%" ),
            ( 86, "Full Cover Share, April 2019 Reforms", CALCULATE ( FORMAT ( [Full Cover Share, April 2019 Reforms], "0.0%" ), dim_date[quarter_end] = DATE ( 2019, 6, 30 ) ), "41.3%" ),
            ( 87, "Full Cover Share, April 2019 Reforms Label", CALCULATE ( [Full Cover Share, April 2019 Reforms Label], dim_date[quarter_end] = DATE ( 2019, 6, 30 ) ), "April 2019 reforms" ),
            ( 88, "Title, Excess", [Title, Excess], "Since the April 2019 rule change, policies with an excess over 500 dollars went from 0.5% to 29.4%" ),
            ( 89, "Title, State Gap", [Title, State Gap], "Full cover is rarest in Western Australia and most common in Tasmania: 3.7 points below and 11.9 above the national 26.8%" ),
            ( 90, "Footnote, Downgrading", [Footnote, Downgrading], "Full cover means no exclusions and no reduced cover. APRA counts the mix of policies at each quarter end, not who switched, so thinner cover can come from members downgrading or from new members buying less. In the excess chart, quarters before September 2010 are left out: the share drops 4.1 points that quarter, and APRA's notes do not explain why." ),
            ( 91, "Takeaway, Older Pool", [Takeaway, Older Pool], "Yes. By June 2025, people aged 65 and over made up 20.7% of the insured, up from 13.3% in June 2007. Across Australia the share rose less, from 13.1% to 17.4%." ),
            ( 92, "Title, Ageing", [Title, Ageing], "Insured people are ageing faster than Australia: aged 65+ rose from 13.3% to 20.7% of the insured, against 13.1% to 17.4% of everyone" ),
            ( 93, "Share Aged 65+, Axis Min", FORMAT ( [Share Aged 65+, Axis Min], "0%" ), "10%" ),
            ( 94, "Share Aged 65+, Axis Max", FORMAT ( [Share Aged 65+, Axis Max], "0%" ), "25%" ),
            ( 95, "Age Gap, Axis Max", FORMAT ( [Age Gap, Axis Max], "0" ), "10" ),
            ( 96, "Title, Age Mix", [Title, Age Mix], "Every age group under 65 shrank as a share of the insured; 65 and over grew from 13.3% to 20.7%" ),
            ( 97, "Subtitle, Age Mix", [Subtitle, Age Mix], "Share of people in each age group, June 2007 and June 2025: people with hospital cover against all Australians." ),
            ( 98, "Title, Change by Age", [Title, Change by Age], "Coverage rose most among 85–89-year-olds, up 18.9 points since June 2007, and fell among 0–4, 25–29, 30–34, 50–54, 55–59 and 60–64-year-olds" ),
            ( 99, "Subtitle, Change by Age", [Subtitle, Change by Age], "Change in the share of each age band with hospital cover, June 2007 to June 2025, percentage points. National figures." ),
            ( 100, "Footnote, Older Pool", [Footnote, Older Pool], "These figures are for Australia as a whole: APRA's population by age has no state breakdown. In June 2018 its population table lacks women aged 95+, so Australia's 65+ share is slightly understated that year. Population by age is published once a year, to June 2025." ),
            ( 101, "Footer Source", [Footer Source], "Source: APRA quarterly private health insurance statistics, June 2026 release, and annual membership and benefits statistics 2024–25. Population: ABS, as published by APRA. Figures, titles and takeaways are computed from the data and update with each release. Latest release: June 2026." ),
            ( 102, "Full Cover Share, Chart Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Full Cover Share, Chart Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "June 2007 63.6%; June 2019 April 2019 reforms; June 2026 26.8%" )
        }
EVALUATE
    SELECTCOLUMNS (
        Checks,
        "No", [Value1],
        "Measure", [Value2],
        "Power BI", [Value3],
        "Guide", [Value4],
        "Match", IF ( [Value3] = [Value4], "yes", "NO" )
    )
ORDER BY [No]
