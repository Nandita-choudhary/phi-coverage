
DEFINE
    VAR Checks =
        {
            ( 1, "Insured Persons", FORMAT ( [Insured Persons], "#,0" ), "12,823,752" ),
            ( 2, "Hospital Policies", FORMAT ( [Hospital Policies], "#,0" ), "6,268,336" ),
            ( 3, "Coverage Rate", FORMAT ( [Coverage Rate], "0.0%" ), "45.8%" ),
            ( 4, "Insured Persons, Change on a Year Earlier",
                 FORMAT ( [Insured Persons, Change on a Year Earlier], "+#,0;-#,0" ), "+292,743" ),
            ( 5, "Full Cover Share", FORMAT ( [Full Cover Share], "0.0%" ), "26.8%" ),
            ( 6, "Excess Over 500 Share", FORMAT ( [Excess Over 500 Share], "0.0%" ), "29.4%" ),
            ( 7, "Share Aged 65+, Insured", FORMAT ( [Share Aged 65+, Insured], "0.0%" ), "20.7%" ),
            ( 8, "Share Aged 65+, Australia", FORMAT ( [Share Aged 65+, Australia], "0.0%" ), "17.4%" ),
            ( 9, "Data Period", [Data Period], "APRA data · June 2007 to June 2026" ),
            ( 10, "Insured Persons Context", [Insured Persons Context], "Up 40.2% since June 2007" ),
            ( 11, "Insured Persons Change Context", [Insured Persons Change Context], "Up 2.3% on June 2025" ),
            ( 12, "Coverage Rate Context", [Coverage Rate Context], "Peak 47.4% in June 2015" ),
            ( 13, "Hospital Policies Context", [Hospital Policies Context], "Up 43.5% since June 2007" ),
            ( 14, "Full Cover Share Context", [Full Cover Share Context], "Down from 63.6% in June 2007" ),
            ( 15, "Excess Over 500 Share Context", [Excess Over 500 Share Context], "Up from 0.5% in March 2019" ),
            ( 16, "Full Cover Share, Australia", FORMAT ( [Full Cover Share, Australia], "0.0%" ), "26.8%" ),
            ( 17, "Full Cover Share, Australia Label", [Full Cover Share, Australia Label], "Australia 26.8%" ),
            ( 18, "Full Cover Share Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Full Cover Share Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "June 2007 63.6%; June 2026 26.8%" ),
            ( 19, "Excess Over 500 Share Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Excess Over 500 Share Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "March 2019 0.5%; June 2026 29.4%" ),
            ( 20, "Share Aged 65+, Insured Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Share Aged 65+, Insured Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "June 2007 13.3%; June 2025 20.7%" ),
            ( 21, "Share Aged 65+, Australia Key Label", CONCATENATEX ( FILTER ( ADDCOLUMNS ( VALUES ( dim_date[quarter_end] ), "@L", [Share Aged 65+, Australia Key Label] ), NOT ISBLANK ( [@L] ) ), FORMAT ( dim_date[quarter_end], "mmmm yyyy" ) & " " & [@L], "; ", dim_date[quarter_end], ASC ), "June 2007 13.1%; June 2025 17.4%" ),
            ( 22, "Coverage Change by Age (points)", CONCATENATEX ( ADDCOLUMNS ( VALUES ( dim_age_band[age_band] ), "@C", FORMAT ( [Coverage Change by Age (points)], "+0.0;-0.0;0.0" ) ), dim_age_band[age_band] & " " & [@C], "; ", CALCULATE ( MIN ( dim_age_band[age_band_start] ) ), ASC ), "0-4 -1.7; 5-9 +4.4; 10-14 +4.9; 15-19 +1.5; 20-24 +0.2; 25-29 -2.7; 30-34 -3.6; 35-39 +1.1; 40-44 +3.7; 45-49 +2.4; 50-54 -3.9; 55-59 -5.3; 60-64 -4.9; 65-69 +2.3; 70-74 +9.0; 75-79 +9.2; 80-84 +17.9; 85-89 +18.9; 90-94 +14.2; 95+ +6.4" ),
            ( 23, "Reconciliation Source", CONCATENATEX ( VALUES ( reconciliation_panel[measure] ), [Reconciliation Source], "; ", [Reconciliation Source], ASC ), "ACCC; ACCC; APRA; CHOICE; CHOICE" ),
            ( 24, "Reconciliation Match", FORMAT ( COUNTROWS ( FILTER ( VALUES ( reconciliation_panel[measure] ), [Reconciliation Match] = "✓ Yes" ) ), "0" ) & " of 5", "5 of 5" ),
            ( 25, "Coverage Share Label, First Quarter", [Coverage Share Label, First Quarter], "43.9%" ),
            ( 26, "Coverage People Label, First Quarter", [Coverage People Label, First Quarter], "9.1M of 20.8M" ),
            ( 27, "Coverage Share Label, Latest Quarter", [Coverage Share Label, Latest Quarter], "45.8%" ),
            ( 28, "Coverage People Label, Latest Quarter", [Coverage People Label, Latest Quarter], "12.8M of 28.0M" ),
            ( 29, "Quarter Label, First", [Quarter Label, First], "June 2007" ),
            ( 30, "Quarter Label, Latest", [Quarter Label, Latest], "June 2026" ),
            ( 31, "Gap to Australia (points), WA", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "WA" ), "-3.7" ),
            ( 32, "Gap to Australia (points), VIC", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "VIC" ), "-3.1" ),
            ( 33, "Gap to Australia (points), ACT", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "ACT" ), "-2.8" ),
            ( 34, "Gap to Australia (points), QLD", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "QLD" ), "+0.2" ),
            ( 35, "Gap to Australia (points), NSW", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "NSW" ), "+1.3" ),
            ( 36, "Gap to Australia (points), NT", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "NT" ), "+5.2" ),
            ( 37, "Gap to Australia (points), SA", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "SA" ), "+8.0" ),
            ( 38, "Gap to Australia (points), TAS", CALCULATE ( FORMAT ( [Full Cover Share, Gap to Australia (points)], "+0.0;-0.0;0.0" ), dim_state[state] = "TAS" ), "+11.9" ),
            ( 39, "Age Mix Share, Insured, June 2007, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "29.7" ),
            ( 40, "Age Mix Share, Insured, June 2007, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "34.5" ),
            ( 41, "Age Mix Share, Insured, June 2007, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "22.5" ),
            ( 42, "Age Mix Share, Insured, June 2007, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 1, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "13.3" ),
            ( 43, "Age Mix Share, Insured, June 2025, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "27.4" ),
            ( 44, "Age Mix Share, Insured, June 2025, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "32.3" ),
            ( 45, "Age Mix Share, Insured, June 2025, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "19.6" ),
            ( 46, "Age Mix Share, Insured, June 2025, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 2, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "20.7" ),
            ( 47, "Age Mix Share, Australians, June 2007, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "33.4" ),
            ( 48, "Age Mix Share, Australians, June 2007, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "35.8" ),
            ( 49, "Age Mix Share, Australians, June 2007, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "17.7" ),
            ( 50, "Age Mix Share, Australians, June 2007, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 3, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "13.1" ),
            ( 51, "Age Mix Share, Australians, June 2025, Under 25", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 1 ) * 100, "0.0" ), "30.2" ),
            ( 52, "Age Mix Share, Australians, June 2025, 25–49", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 2 ) * 100, "0.0" ), "35.0" ),
            ( 53, "Age Mix Share, Australians, June 2025, 50–64", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 3 ) * 100, "0.0" ), "17.3" ),
            ( 54, "Age Mix Share, Australians, June 2025, 65 and over", FORMAT ( CALCULATE ( [Age Mix Share], mix_bars[bar_order] = 4, dim_age_band[age_group4_order] = 4 ) * 100, "0.0" ), "17.4" ),
            ( 55, "Age Gap Series (points), June 2007", CALCULATE ( FORMAT ( [Age Gap Series (points)], "0.0" ), dim_date[quarter_end] = DATE ( 2007, 6, 30 ) ), "0.2" ),
            ( 56, "Age Gap Series (points), June 2025", CALCULATE ( FORMAT ( [Age Gap Series (points)], "0.0" ), dim_date[quarter_end] = DATE ( 2025, 6, 30 ) ), "3.3" )
        }
EVALUATE
    SELECTCOLUMNS (
        Checks,
        "No", [Value1],
        "Measure", [Value2],
        "Power BI", [Value3],
        "Guide", [Value4],
        "Match", IF ( [Value3] = [Value4], "yes", "NO" )
    )
ORDER BY [No]
