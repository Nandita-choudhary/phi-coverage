                      "fontSize": "4pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Coverage is people with hospital cover divided by the population. People, policies and population are each counted at the end of a quarter.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#52514E"
                    }
                  }
                ]
              },
              {
                "textRuns": [
