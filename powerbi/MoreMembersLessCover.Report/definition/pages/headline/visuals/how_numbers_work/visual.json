    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How the numbers work",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt",
                      "color": "#F1F5F9"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Coverage is people with hospital cover divided by Australia's population.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#94A3B8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "People, policies and population are counted at the end of each quarter, so a period's figure is its latest quarter, never a sum.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#94A3B8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Every figure traces back to a cell in APRA's spreadsheets. The five published figures on the right were rebuilt from them and match at the precision they were published.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#94A3B8"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
