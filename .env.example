# Copy this file to .env and fill in your own values. .env is gitignored: keep it that way.
#
# Azure portal → your SQL server: its name ends in .database.windows.net. Use the SQL login you
# created with the server. The driver is pymssql, which needs nothing else installed.
# Symbols in the password such as @ : / # must be URL-encoded (@ becomes %40).
# The same value goes in the GitHub repository secret AZURE_SQL_URL, for the scheduled run.
AZURE_SQL_URL=mssql+pymssql://[USER]:[PASSWORD]@[SERVER].database.windows.net:1433/[DATABASE]
